<?xml version="1.0" encoding="utf-8"?>
<!--
    `V02-008`: the harness build type's manifest.

    Everything above the Activities is a verbatim repeat of `src/google/AndroidManifest.xml`,
    because a build type contributes exactly one manifest and this one has to carry both halves.
    `verifyGooglePocMergedManifest` asserts each of those entries on every Google variant, so the
    repetition cannot silently diverge from the shared file.

    What is not repeated anywhere else is below: the two engineering Activities, which exist only
    in this build type. A release-configured Google build declares neither and compiles neither.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/trailveil_google_maps_poc_api_key" />
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="app.trailveil.map.GoogleMapWarmup"
                android:value="androidx.startup" />
        </provider>
        <!-- `V02-005` stage 2, the launcher inversion: the production MainActivity and its real
             navigation graph ARE the googlePoc experience from here on. The PoC Activity is
             de-launchered and unexported, retained solely as the AVD engineering harness the
             googlePoc benchmark/boundary suites drive. -->
        <activity
            android:name=".googlepoc.GoogleMapsPocActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TrailVeil" />
        <activity
            android:name=".map.GoogleMapSurfaceTestActivity"
            android:exported="false"
            android:theme="@style/Theme.TrailVeil" />
    </application>
</manifest>
