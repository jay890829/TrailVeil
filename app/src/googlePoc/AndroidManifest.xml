<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/trailveil_google_maps_poc_api_key" />
        <!-- `V02-005` stage 2, the launcher inversion: the production MainActivity and its real
             navigation graph ARE the googlePoc experience from here on. The PoC Activity is
             de-launchered and unexported, retained solely as the AVD engineering harness the
             googlePoc benchmark/boundary suites drive until `V02-007`. -->
        <activity
            android:name=".googlepoc.GoogleMapsPocActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TrailVeil" />
        <activity
            android:name=".map.GoogleMapSurfaceTestActivity"
            android:exported="false"
            android:theme="@style/Theme.TrailVeil" />
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="app.trailveil.map.GoogleMapWarmup"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
