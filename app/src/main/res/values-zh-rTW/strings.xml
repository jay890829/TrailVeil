    <string name="recording_completed_title">探索已保存</string>
    <string name="recording_completed_text">記錄已停止，這次探索已保存在這台裝置。</string>
    <string name="recording_interrupted_title">探索已中斷</string>
    <string name="recording_interrupted_text">記錄意外停止，已保存的位置仍保留在歷史中。</string>
